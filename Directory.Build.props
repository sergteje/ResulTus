<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Package validation compares the packed surface against the last released package, so a removed
    or re-signed public member fails `dotnet pack` before anything reaches nuget.org. It only runs
    when a project is actually packed, which is why it can live here unconditionally.
    Baseline rule: bump PackageValidationBaselineVersion when a new minor or major ships, so the
    comparison always targets a version consumers actually have. Not a build-time check: `dotnet
    build` never downloads the baseline.
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.2.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Description>ResulTus — High-performance Result Pattern library for .NET</Description>
    <Version>1.2.0</Version>
    <Authors>ResulTus Contributors</Authors>
    <Company>ResulTus</Company>
    <Copyright>Copyright (c) ResulTus. All rights reserved.</Copyright>
    <RepositoryUrl>https://github.com/sergteje/ResulTus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sergteje/ResulTus</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Result;Errors;Functional;Dotnet;CSharp;ZeroAllocation;Performance</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets\branding\icon.png"
          Pack="true"
          PackagePath="" />
  </ItemGroup>

</Project>
