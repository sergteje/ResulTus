# Strict .NET conventions for ResulTus
root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true

# XML documentation
[*.cs]
dotnet_diagnostic.CS1591.severity = error
dotnet_diagnostic.CS1573.severity = error
dotnet_diagnostic.CS1712.severity = error

# Nullable warnings
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8601.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8609.severity = error
dotnet_diagnostic.CS8610.severity = error
dotnet_diagnostic.CS8614.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8619.severity = error
dotnet_diagnostic.CS8620.severity = error
dotnet_diagnostic.CS8625.severity = error

# Warnings as errors — catch all
dotnet_analyzer_diagnostic.category-Severity.severity = error

# Naming conventions
dotnet_naming_rule.types_and_namespaces_must_be_pascal_case.severity = error
dotnet_naming_rule.types_and_namespaces_must_be_pascal_case.symbols = types_and_namespaces
dotnet_naming_rule.types_and_namespaces_must_be_pascal_case.style = pascal_case
dotnet_naming_symbols.types_and_namespaces.applicable_kinds = class, struct, interface, enum, namespace
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.private_fields_must_start_with_underscore.severity = error
dotnet_naming_rule.private_fields_must_start_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_must_start_with_underscore.style = underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.required_modifiers = private
dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

# File header
file_header_template = Copyright (c) ResulTus. All rights reserved.
[*.{cs,vb}]
file_header_template = Copyright (c) ResulTus. All rights reserved.
