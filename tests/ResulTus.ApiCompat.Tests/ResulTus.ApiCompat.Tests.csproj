<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ResulTus.ApiCompat.Tests</RootNamespace>
    <AssemblyName>ResulTus.ApiCompat.Tests</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);IL2026;IL2070;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ResulTus\ResulTus.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.Extensions\ResulTus.Extensions.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.Collections\ResulTus.Collections.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.Serialization\ResulTus.Serialization.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.AspNetCore\ResulTus.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.HttpClient\ResulTus.HttpClient.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.Logging\ResulTus.Logging.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.Diagnostics\ResulTus.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.Validation\ResulTus.Validation.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.Validation.FluentValidation\ResulTus.Validation.FluentValidation.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.Testing\ResulTus.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the ApiSnapshot tool: one file is both the writer of the snapshots and the
         reader of the contract, so the surface cannot diverge between the two. -->
    <Compile Include="..\..\scripts\ApiSnapshot\Surface.cs" Link="Surface.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PublicApi\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
