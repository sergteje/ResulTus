<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ResulTus.SourceGenerators.Tests</RootNamespace>
    <AssemblyName>ResulTus.SourceGenerators.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Directory.Build.props turns IsAotCompatible on for every project, including test
         assemblies. A test assembly is never trimmed or AOT-compiled. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The compilations built by the harness need metadata references to the core assembly,
         because the generated code calls into it and the test sources carry the attributes. -->
    <ProjectReference Include="..\..\src\ResulTus\ResulTus.csproj" />
    <ProjectReference Include="..\..\src\ResulTus.SourceGenerators\ResulTus.SourceGenerators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not PrivateAssets here: the tests build CSharpCompilation themselves. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

</Project>
