# Line endings and diff behaviour are decided here, not by each contributor's core.autocrlf.
# The repository stores text with LF; a Windows checkout materialises CRLF for the toolchain.
* text=auto

*.cs      text diff=csharp
*.csproj  text diff=xml
*.props   text diff=xml
*.targets text diff=xml
*.slnx    text diff=xml
*.json    text
*.yml     text
*.md      text diff=markdown
*.txt     text
*.ps1     text eol=crlf
*.sh      text eol=lf
.gitattributes text
.gitignore     text

# Binary: never converted, never merged as text.
*.png   binary
*.snk   binary
*.pfx   binary
*.nupkg binary
# One-time note: the index still holds files committed with CRLF before this file
# existed. `git add --renormalize .` converts them to LF in a single commit that
# touches every file; that is a repository-wide decision for the owner, not a
# side effect of adding this attribute file.