{
  "$schema": "https://dotnet.github.io/docfx/schema/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ],
          "exclude": [
            "**/ResulTus.Analyzers/**",
            "**/ResulTus.SourceGenerators/**"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "index.md"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "ResulTus",
      "_appName": "ResulTus",
      "_appFooter": "ResulTus — High-performance Result Pattern library for .NET",
      "_disableContribution": true,
      "_enableSearch": true
    }
  }
}
